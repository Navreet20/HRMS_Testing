# hrms-backend environment template. Copy to .env and fill in real values.
# Never commit .env.
#
# Every key below is required: the app has no defaults in code and will not start
# if one is missing (the error names it). Keys you do not need can stay empty,
# for example COOKIE_DOMAIN= or SMTP_PASS=.

# --- API server ---
# Port for `uv run main.py` / `python scripts/run_dev.py` (override with --port).
# If you change it, also change REDIRECT_URI below, the Azure redirect URI, and
# API_PROXY_TARGET in hrms-frontend/.env. Ports below 1024 need admin rights.
PORT=5001

# --- Database ---
# Connection is built from these five values; DATABASE_URL is not read.
# Default is the team's shared Neon Postgres: use the host/user/password the
# team gave you. For a natively installed local Postgres use localhost:5432.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=hrms_local_dev
DB_NAME=hrms

# Connection pool settings — safe as-is unless you know why you're changing them.
DB_POOL_CLASS=queue
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=280
DB_POOL_TIMEOUT=30

# SSL: most managed/cloud Postgres providers require this to be true.
# A natively installed local Postgres and CI's disposable container require false.
# See app/core/config.py (db_ssl) and app/db/session.py for how this is used.
DB_SSL=true

# --- Auth ---
# Signs login cookies on THIS machine. Generate your own:
#   openssl rand -hex 32
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
# Browser origins allowed to call the API. Must include the Next port you run.
# This project: frontend 3000 + API 5001 (see hrms-frontend package.json).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Login cookies (eaova_access + eaova_csrf). Defaults match local http://localhost.
# COOKIE_SECURE=true only when the site is HTTPS (production). false for local HTTP.
# COOKIE_SAMESITE: lax is normal; none only if frontend/API are different sites + HTTPS.
# COOKIE_DOMAIN: leave empty for localhost; set e.g. .company.com for shared subdomains.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# true skips JWT/CSRF — local debugging only, never on a shared server.
AUTH_BYPASS=false
ENVIRONMENT=development

# Module access grant source: db = Manage Access (RBAC) grant rows.
RBAC_GRANT_SOURCE=db

# --- Microsoft Entra ID (required for sign-in; AUTH_BYPASS skips this) ---
# From Azure Portal → Microsoft Entra ID → App registrations → your app.
# TENANT_ID: Overview → Directory (tenant) ID (GUID).
# CLIENT_ID: Overview → Application (client) ID (GUID).
# CLIENT_SECRET: Certificates & secrets → New client secret → copy the *Value*
#   (not the Secret ID). Shown once; never commit the real value.
# REDIRECT_URI: Authentication → Web platform → must match exactly.
# MSAL_REDIRECT_URI: frontend origin the user returns to after sign-in.
# Summary: Azure Portal → App registrations → your app. IDs from Overview; secret
# is the *Value* from Certificates & secrets (never commit it). REDIRECT_URI must
# match the app's registered redirect URI exactly. MSAL_REDIRECT_URI is the
# frontend page users return to after sign-in.
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=your-entra-client-secret-value
REDIRECT_URI=http://localhost:5001/api/v1/auth/entra/callback
MSAL_REDIRECT_URI=http://localhost:3000/
SCOPES=openid profile email User.Read

# --- Superadmin allowlist ---
# Comma-separated Microsoft sign-in emails; each gets a Superadmin account on first sign-in.
SUPERADMIN_EMAILS=durga.paruchuri@arohak.com,venkata.nagalla@arohak.com,navreet.kaur@cognivance.com,rashmika.alishetty@arohak.com


# --- Object storage (MinIO / S3-compatible) ---
# Endpoint has no scheme; MINIO_SECURE picks http vs https.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hrms-documents
MINIO_SECURE=false

# Encrypts Gov ID, bank, and document numbers in the database.
# MUST be the same on every machine sharing a database.
# Generate once: openssl rand -hex 32
# Then paste the same value into every teammate's .env (do not commit it).
FIELD_ENCRYPTION_KEY=

# --- Onboarding ---
# Activate bookkeeping only; real invite mail is Employees -> Invite.
ONBOARDING_SEND_INVITE_EMAIL=true

# --- Email ---
# Notifications are queued and sent by a background worker with retries; the
# invite is sent at once (it fails closed: the employee stays a draft).
# EMAIL_PROVIDER picks delivery; "smtp" uses the SMTP_* settings below.
EMAIL_PROVIDER=smtp
NOTIFICATION_WORKER_ENABLED=true
# 0 = the worker sleeps until an email is queued or a retry is due. Do not poll
# every few seconds on Neon: it keeps the database awake and burns compute hours.
NOTIFICATION_POLL_SECONDS=0
# 0 = edited email wording loads at start-up and after each save. Use 60 when
# several backends share one database, so an edit reaches all of them.
TEMPLATE_REFRESH_SECONDS=0
# Paste the SMTP password/key into SMTP_PASS (never commit real secrets).
# Leave SMTP_USER and SMTP_PASS empty if the server needs no login.
SMTP_ENABLED=true
SMTP_HOST=mail.yourcompany.com
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none (internal relay).
SMTP_SECURITY=starttls
SMTP_USER=your-smtp-username
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@yourcompany.com
SMTP_FROM_NAME=EAOVA

# Frontend origin linked from emails, e.g. the invite (no trailing slash).
# Keep in sync with CORS_ORIGINS and `npm run dev` port (3000 for this repo).
APP_PUBLIC_URL=http://localhost:3000

# --- Geocode (Photon) ---
# Address autocomplete for office / employee forms. Requires auth via /api/v1.
GEOCODER_BASE_URL=https://photon.komoot.io
GEOCODER_USER_AGENT=HRMS-LocationPicker/1.0 (office-location-form; Photon)
