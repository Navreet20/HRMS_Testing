# Same-origin API via Next.js rewrites (required for httpOnly cookies).
# Do NOT point at http://localhost:5001 directly from the browser.
NEXT_PUBLIC_API_BASE=/api/v1

# Temporary local/dev only — set false (or remove) for real auth.
# Must match backend AUTH_BYPASS=true.
NEXT_PUBLIC_AUTH_BYPASS=false

# FastAPI origin for Next rewrites (server-side only; required — no config fallback).
API_PROXY_TARGET=http://127.0.0.1:5001

# Geocoding is proxied by FastAPI (GET /api/v1/geocode/search).
# Configure GEOCODER_* on the backend (.env), not here.
